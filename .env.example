# ─── DATABASE ────────────────────────────────────────────
# Ottieni da: https://neon.tech (piano gratuito)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/quaserboard?sslmode=require"

# ─── NEXTAUTH ─────────────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET="genera-una-stringa-casuale-sicura-qui"
NEXTAUTH_URL="http://localhost:3000"

# ─── EMAIL (Resend) ───────────────────────────────────────
# Ottieni da: https://resend.com (piano gratuito: 3000 email/mese)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@tuodominio.it"

# ─── STORAGE DOCUMENTI (Vercel Blob) ─────────────────────
# Ottieni da: Vercel dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_xxxxxxxxxxxxxxxx"

# ─── APP ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Quaser Board"
